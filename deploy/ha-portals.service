[Unit]
Description=HA-PORTALS FastAPI Backend
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/WorkSpace/project/HA-PORTALS/backend
Environment="PATH=/home/admin/WorkSpace/project/HA-PORTALS/backend/venv/bin:/usr/bin"
EnvironmentFile=/home/admin/WorkSpace/project/HA-PORTALS/backend/.env
ExecStart=/home/admin/WorkSpace/project/HA-PORTALS/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
